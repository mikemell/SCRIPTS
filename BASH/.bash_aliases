alias echo='echo -e'
alias biorythm='LDATE=$((($(date -u +%-s)-$(date -u +%-s -d 19620108))/86400)) && echo "${LDATE}, P$((${LDATE}-$(($((${LDATE}/23))*23))))/23, E$((${LDATE}-$(($((${LDATE}/28))*28))))/28, M$((${LDATE}-$(($((${LDATE}/33))*33))))/33"'
alias jdate='echo "$((($(date +%-s)-$(date +%-s -d $(date +%-Y)0101))/86400+1))"'
alias bdate='echo "$((($(date -u +%-s)-$(date -u +%-s -d 19620108))/86400))"'
alias mdate='echo "$((($(date -u +%-s)-$(date -u +%-s -d 19880623))/86400))"'
alias odate='echo "$((($(date -u +%-s)-$(date -u +%-s -d 20250411))/86400))"'
alias dtime='printf ".%-5d\n" $((($(($(date -u +"%-H * 3600000 + %-M * 6000 + %-S * 1000")))/864)))'
alias dref='printf ".%-1d\n" $((($(($(date -u +"%-H * 3600 + %-M * 6 + %-S")))/8640)))'
alias odyssey='echo "$(mdate)$(dref)"'
alias logedit='date >> ~/Documents/Odyssey/$(oref) && echo >> ~/Documents/Odyssey/$(oref) && cat $1 >> ~/Documents/Odyssey/$(oref) && echo "-----" >> ~/Documents/Odyssey/$(oref) && echo >> ~/Documents/Odyssey/$(oref)'
alias loglist='ls ~/Documents/Odyssey/[1-9]* | for FILE in $(ls ~/Documents/Odyssey/[1-9]*) ; do basename ${FILE} ; done | sort -n'
alias ls='ls --color=auto'
alias dir='dir --color=auto'
alias vdir='vdir --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias runcob='/usr/bin/cobc 2>/dev/null -j -x'
alias basic='/usr/bin/bwbasic /home/mmell/SCRIPTS/BASIC/basic.h'
